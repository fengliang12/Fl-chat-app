# React 前端环境变量

# 合约地址（部署后填入）
REACT_APP_CERTIFICATION_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_YD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# 网络配置
REACT_APP_CHAIN_ID=1
REACT_APP_NETWORK_NAME=mainnet

# API 端点（后端服务）
REACT_APP_API_URL=http://localhost:3001

# 其他配置
REACT_APP_ENABLE_DEBUG=false
